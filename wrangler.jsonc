{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aangan",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "account_id": "b45bd4f50a1e0280366712348fe2055a",
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thrilokha-commerce",
      "database_id": "f696ffeb-cee1-43ba-9160-0de3e8666163"
    }
  ]
}
